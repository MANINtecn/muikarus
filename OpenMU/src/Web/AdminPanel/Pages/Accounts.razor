@page "/accounts"
@using MUnique.OpenMU.DataModel
@using MUnique.OpenMU.DataModel.Entities;
@using MUnique.OpenMU.Persistence;
@using Resources = MUnique.OpenMU.Web.AdminPanel.Properties.Resources

@inject AccountService _accountService;
@inject IModalService _modalService;
@inject IToastService _toastService;

@{
  var title = typeof(Account).GetPluralizedTypeCaption();
}
<PageTitle>OpenMU: @title</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@title" />
<h1>@title</h1>

<div>
    <DataTable TItem=@Account>
        <TableHeader>
            <th class="col-1">@typeof(Account).GetPropertyCaption(nameof(Account.LoginName))</th>
            <th class="col-1">@typeof(Account).GetPropertyCaption(nameof(Account.State))</th>
            <th class="col-2">@typeof(Account).GetPropertyCaption(nameof(Account.EMail))</th>
            <th class="col-2">@Resources.Action</th>
        </TableHeader>
        <FilterHeader>
            <th colspan="3">
                <div class="input-group">
                    <span class="input-group-text"><span class="oi oi-magnifying-glass" aria-hidden="true"></span></span>
                    <input class="form-control small" type="search" autofocus @bind="@this._accountService.SearchFilter" @bind:event="oninput" placeholder="@Resources.Search ..."/>
                </div>
            </th>
            <th>
                <select class="form-select form-select-sm" value="@this.GetStateFilterValue()" @onchange="this.OnStateFilterChangedAsync">
                    <option value="">@Resources.AllStates</option>
                    @foreach (var state in Enum.GetValues<AccountState>())
                    {
                        <option value="@state">@state.GetEnumCaption()</option>
                    }
                </select>
            </th>
        </FilterHeader>
        <ItemTemplate Context="item">
            <td>@item.LoginName</td>
            <td>@item.State.GetEnumCaption()</td>
            <td>@item.EMail</td>
            <td>
                <NavLink href="@($"edit-account/{item.GetId()}/{typeof(Account).FullName}/{item.GetId()}")" class="btn btn-primary me-1"><span class="oi oi-pencil" aria-hidden="true"></span> Edit</NavLink>
                @if (item.State == AccountState.Banned)
                {
                    <button type="button" class="btn btn-success btn-sm" @onclick="() => this.OnUnbanClickAsync(item)"><span class="oi oi-check" aria-hidden="true"></span> @Resources.Unban</button>
                }
                else
                {
                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => this.OnBanClickAsync(item)"><span class="oi oi-ban" aria-hidden="true"></span> @Resources.Ban</button>
                }
            </td>
        </ItemTemplate>
        <TableFooter>
            <td><button type="button" class="btn btn-primary" @onclick="@this._accountService.CreateNewInModalDialogAsync">@Resources.Create</button></td>
            <td></td>
            <td></td>
            <td></td>
        </TableFooter>
    </DataTable>
</div>

@code {
    private string GetStateFilterValue() => this._accountService.StateFilter?.ToString() ?? string.Empty;

    private Task OnStateFilterChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value as string;
        this._accountService.StateFilter = string.IsNullOrEmpty(value) ? null : Enum.Parse<AccountState>(value);
        return Task.CompletedTask;
    }

    private async Task OnBanClickAsync(Account account)
    {
        var confirmed = await this._modalService.ShowQuestionAsync(Resources.Ban, string.Format(Resources.ConfirmBanAccount, account.LoginName));
        if (!confirmed)
        {
            return;
        }

        await this._accountService.BanAsync(account);
        this._toastService.ShowSuccess(string.Format(Resources.AccountBanned, account.LoginName));
    }

    private async Task OnUnbanClickAsync(Account account)
    {
        var confirmed = await this._modalService.ShowQuestionAsync(Resources.Unban, string.Format(Resources.ConfirmUnbanAccount, account.LoginName));
        if (!confirmed)
        {
            return;
        }

        await this._accountService.UnbanAsync(account);
        this._toastService.ShowSuccess(string.Format(Resources.AccountUnbanned, account.LoginName));
    }
}
